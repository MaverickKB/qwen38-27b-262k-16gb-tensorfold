From 5f35c39feaeb34395d8640f4ececb4edbd5c7e67 Mon Sep 17 00:00:00 2001
From: MaverickKB <kbandoly@synetron.com>
Date: Sun, 8 Nov 2026 22:52:29 -0500
Subject: [PATCH] qwen3_5: TF_QWEN_KV_HOST Phase 2 - device-resident state
 runs; host pages carry KV only. Measured 43.7 tok/s @0, 27.3 @32K, 14.2
 @131K, 8.5 @258K

---
 zig/src/families/qwen3_5/cuda_pages.zig | 20 +++++++++++++++-----
 zig/src/native/cuda_kv_pool.zig         | 12 ++++++++++--
 2 files changed, 25 insertions(+), 7 deletions(-)

diff --git a/zig/src/families/qwen3_5/cuda_pages.zig b/zig/src/families/qwen3_5/cuda_pages.zig
index 2c17168..e35b61b 100644
--- a/zig/src/families/qwen3_5/cuda_pages.zig
+++ b/zig/src/families/qwen3_5/cuda_pages.zig
@@ -50,7 +50,7 @@ pub fn layout(e: *const Engine, capacity: usize, tokens: usize, ring: usize, fix
 }
 
 /// One pool lane: a cache whose table maps its stream's pages, that stream's lease and its run's first page.
-const Lane = struct { cache: *Cache, lease: kv.Lease = .{}, used: bool = false, run: u32 = 0 };
+const Lane = struct { cache: *Cache, lease: kv.Lease = .{}, used: bool = false, run: u32 = 0, idx: usize = 0 };
 
 pub const Pages = struct {
     gpa: std.mem.Allocator,
@@ -65,6 +65,8 @@ pub const Pages = struct {
     host: ?cuda.HostBuffer = null,
     /// The arena's device address: `arena.ptr`, or the mapped host pointer when host-funded.
     base: u64 = 0,
+    /// Phase 2: the state runs live on the card (one slot per lane); only the KV pages are host-funded.
+    run_dev: ?cuda.DeviceBuffer = null,
     lanes: []Lane,
 
     /// `streams` lanes and `pages` pages of layout `l`, made and touched now; each run holds a `ring`-byte ring.
@@ -88,9 +90,14 @@ pub const Pages = struct {
             arena = try cuda.DeviceBuffer.alloc(e.d, total);
             base = arena.ptr;
         }
+        var run_dev: ?cuda.DeviceBuffer = null;
+        if (host != null) {
+            run_dev = try cuda.DeviceBuffer.alloc(e.d, streams * l.runPages() * page_bytes);
+        }
+        errdefer if (run_dev != null) run_dev.?.free();
         errdefer if (host != null) host.?.free();
         errdefer if (host == null) arena.free();
-        p.* = .{ .gpa = gpa, .e = e, .layout = l, .capacity = capacity, .ring = ring, .pool = try kv.Pool.init(gpa, pages, page_bytes), .arena = arena, .host = host, .base = base, .lanes = &.{} };
+        p.* = .{ .gpa = gpa, .e = e, .layout = l, .capacity = capacity, .ring = ring, .pool = try kv.Pool.init(gpa, pages, page_bytes), .arena = arena, .host = host, .base = base, .run_dev = run_dev, .lanes = &.{} };
         errdefer p.pool.deinit();
         p.lanes = try gpa.alloc(Lane, streams);
         errdefer gpa.free(p.lanes);
@@ -99,11 +106,11 @@ pub const Pages = struct {
             x.cache.deinit(gpa);
             gpa.destroy(x.cache);
         };
-        for (p.lanes) |*x| {
+        for (p.lanes, 0..) |*x, li| {
             const c = try gpa.create(Cache);
             errdefer gpa.destroy(c);
             c.* = try Cache.initPaged(gpa, e, mostPages(capacity, tokens), tokens, base);
-            x.* = .{ .cache = c };
+            x.* = .{ .cache = c, .idx = li };
             made += 1;
         }
         errdefer cuda.completion.drain(e.d, e.stream, "qwen3_5: a failed pool initialization did not drain");
@@ -112,6 +119,7 @@ pub const Pages = struct {
             const view = cuda.DeviceBuffer{ .d = e.d, .ptr = p.base, .len = h.bytes.len, .borrowed = true };
             try view.fill8(0, e.stream.handle);
         } else try arena.fill8(0, e.stream.handle);
+        if (p.run_dev) |rd| try rd.fill8(0, e.stream.handle);
         for (p.lanes) |x| try x.cache.paged.?.table.fill8(0, e.stream.handle);
         try e.stream.synchronize();
         return p;
@@ -129,6 +137,7 @@ pub const Pages = struct {
         }
         p.gpa.free(p.lanes);
         if (p.host != null) p.host.?.free() else p.arena.free();
+        if (p.run_dev != null) p.run_dev.?.free();
         p.pool.deinit();
         p.gpa.destroy(p);
     }
@@ -173,7 +182,8 @@ pub const Pages = struct {
         var up: Upload = .{ .p = p, .cache = x.cache };
         if (adopted.len > 0) try Upload.write(&up, x.lease.ids.items, 0);
         try p.pool.cover(&x.lease, n, .{ .ctx = &up, .write = Upload.write });
-        try x.cache.mapRun(p.e, p.base + run * p.layout.pageBytes(), k * p.layout.pageBytes(), p.ring);
+        const run_base = if (p.run_dev) |rd| rd.ptr + x.idx * @as(usize, k) * p.layout.pageBytes() else p.base + run * p.layout.pageBytes();
+        try x.cache.mapRun(p.e, run_base, k * p.layout.pageBytes(), p.ring);
         try x.cache.reset(p.e);
         x.cache.paged.?.ids = x.lease.ids.items;
         x.cache.cap = n * p.layout.page_tokens;
diff --git a/zig/src/native/cuda_kv_pool.zig b/zig/src/native/cuda_kv_pool.zig
index b71e552..9d57803 100644
--- a/zig/src/native/cuda_kv_pool.zig
+++ b/zig/src/native/cuda_kv_pool.zig
@@ -147,7 +147,12 @@ fn fits(comptime F: type, loaded: anytype, o: api.Open, room: u64, window: u64,
     const want = budget.cacheBytes(o.prompt_cache_gib, std.math.maxInt(u64), 0);
     const rows: u64 = if (comptime @hasDecl(F, "window_rows")) F.window_rows else 0;
     const kv_host: u64 = if (comptime @hasDecl(F, "kvHostRoom")) F.kvHostRoom(loaded.ctx) else 0;
-    if (layout(loaded)) |l| return kv_pool.holds(l, .{ .room = room, .engine = 0, .lanes = o.lanes, .fixed = o.lanes_fixed, .cache = want, .snaps = named(o), .window = window + rows, .engine_paged = enginePaged(loaded), .asked = o.prompt_cache_gib != null, .pages_room = kv_host });
+    const run_charge: u64 = if (kv_host > 0) blk: {
+        const ll = layout(loaded).?;
+        const lanes_total: u32 = if (enginePaged(loaded)) o.lanes else o.lanes -| 1;
+        break :blk @as(u64, ll.runPages()) * ll.pageBytes() * lanes_total;
+    } else 0;
+    if (layout(loaded)) |l| return kv_pool.holds(l, .{ .room = room -| run_charge, .engine = 0, .lanes = o.lanes, .fixed = o.lanes_fixed, .cache = want, .snaps = named(o), .window = window + rows, .engine_paged = enginePaged(loaded), .asked = o.prompt_cache_gib != null, .pages_room = kv_host });
     const n = budget.admit(room, stream_bytes, loaded.free_streams, o.lanes, o.lanes_fixed) catch return false;
     return room -| stream_bytes * (n -| loaded.free_streams) >= want;
 }
@@ -156,7 +161,10 @@ fn fits(comptime F: type, loaded: anytype, o: api.Open, room: u64, window: u64,
 pub fn plan(comptime F: type, a: Allocator, l: kv_pool.Layout, room: u64, o: api.Open, window: u64, problem: *[]const u8, host_mode: bool, engine_paged: bool, kept_ppm: u32, slots: ?usize, kv_host: u64) !?Plan {
     const rows: u64 = if (comptime @hasDecl(F, "window_rows")) F.window_rows else 0;
     const want = if (host_mode) 0 else budget.cacheBytes(o.prompt_cache_gib, std.math.maxInt(u64), 0);
-    return kv_pool.plan(l, .{ .room = room, .engine = 0, .lanes = o.lanes, .fixed = o.lanes_fixed, .cache = want, .snaps = slots orelse named(o), .window = window + rows, .engine_paged = engine_paged, .kept_ppm = if (host_mode) 0 else kept_ppm, .slots_only = slots != null, .asked = o.prompt_cache_gib != null, .pages_room = kv_host }) catch |e| {
+    // TF_QWEN_KV_HOST: the state runs stay on the card; charge their arena to the device room.
+    const lanes_total: u32 = if (engine_paged) o.lanes else o.lanes -| 1;
+    const run_charge: u64 = if (kv_host > 0) @as(u64, l.runPages()) * l.pageBytes() * lanes_total else 0;
+    return kv_pool.plan(l, .{ .room = room -| run_charge, .engine = 0, .lanes = o.lanes, .fixed = o.lanes_fixed, .cache = want, .snaps = slots orelse named(o), .window = window + rows, .engine_paged = engine_paged, .kept_ppm = if (host_mode) 0 else kept_ppm, .slots_only = slots != null, .asked = o.prompt_cache_gib != null, .pages_room = kv_host }) catch |e| {
         problem.* = switch (e) {
             error.NoStream => if (engine_paged) try std.fmt.allocPrint(a, "the CUDA memory budget fits no stream beside the model: one at a {d}-token window takes {d:.2} GiB of KV pages{s}, and the budget leaves {d:.2} GiB", .{ window, toGib(l.pages(window + rows) * l.pageBytes()), if (kv_host > 0) " (host-funded)" else "", toGib(room) }) else "the CUDA memory budget fits no stream beside the model",
             error.TooMany => try std.fmt.allocPrint(a, "--parallel {d} needs {d:.2} GiB for its other streams' fixed parts, state runs and a page each, and the CUDA memory budget leaves {d:.2} GiB: serve fewer, or free device memory", .{ o.lanes, toGib((o.lanes - 1) * (l.fixed_bytes + (1 + l.runPages()) * l.pageBytes())), toGib(room) }),
-- 
2.43.0

