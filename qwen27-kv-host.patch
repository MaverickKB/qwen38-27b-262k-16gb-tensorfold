+        var base: u64 = 0;
+        if (kv_host.onHost()) {
+            host = try cuda.HostBuffer.allocMapped(e.d, total);
+            base = try host.?.device();
+        } else {
+            arena = try cuda.DeviceBuffer.alloc(e.d, total);
+            base = arena.ptr;
+        }
+        errdefer if (host != null) host.?.free();
